# فقط فایل‌های تصویری مجاز سرو شوند؛ اجرای هر نوع اسکریپت ممنوع است
<FilesMatch "\.(?i:php\d?|phtml|phar|pl|py|cgi|sh|svg|svgz|html?|js)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; sandbox"
</IfModule>
